{
    "name": "quansitech/cmf-module-rich-content",
    "description": "CMF 富文本扩展：中文 TinyMCE 编辑器、粘贴清理、HTML 白名单清洗、公众号文章抓取、远程图片本地化到 cmf-media。",
    "type": "library",
    "license": "proprietary",
    "require": {
        "amidesfahani/filament-tinyeditor": "^5.0",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "filament/filament": "^5.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "livewire/livewire": "^4.0",
        "php": "^8.3",
        "quansitech/cmf-module-media": "^1.6",
        "tinymce/tinymce": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Quansitech\\Cmf\\RichContent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quansitech\\Cmf\\RichContent\\RichContentServiceProvider",
                "Quansitech\\Cmf\\RichContent\\Providers\\TinyMceServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Quansitech\\Cmf\\RichContent\\Tests\\": "tests/"
        }
    }
}
